# Normalise line endings so the repo is clean on every platform
* text=auto eol=lf

# Binary-ish assets that must not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary

# Generated reports are text and should diff readably
*.html text
*.css text
*.js text
*.py text
*.md text
*.json text
*.csv text
